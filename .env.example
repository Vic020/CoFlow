# Web: Next.js proxies /api to the Go service.
API_BASE_URL=http://127.0.0.1:8080
# Go does not automatically load .env; export these or use your process manager.
DATABASE_URL=postgres://coflow:coflow_dev@127.0.0.1:5432/coflow?sslmode=disable
COFLOW_ADDR=127.0.0.1:8080
COFLOW_WEB_ORIGIN=http://127.0.0.1:3000
# Enable for HTTPS deployments. Leave false only for local HTTP development.
COFLOW_SECURE_COOKIES=false
# Optional independent demo mode. Team mode is the default.
COFLOW_DEMO=false
# First administrator only: generate with openssl rand -hex 32 and export to Go.
# Initialization is blocked when unset. Never use NEXT_PUBLIC_ for this secret.
COFLOW_BOOTSTRAP_TOKEN=
# CLI only: provide a personal Token through the environment, never commit it.
# COFLOW_TOKEN=
