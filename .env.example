# Local development only. Web automatically proxies /api to the Go service.
API_BASE_URL=http://127.0.0.1:8080
# Set these in the Go process environment; Go does not automatically load .env.
COFLOW_DEMO=true
COFLOW_ADDR=127.0.0.1:8080
COFLOW_WEB_ORIGIN=http://127.0.0.1:3000
# Optional PostgreSQL development storage. Apply the SQL schema before starting.
# DATABASE_URL=postgres://coflow:coflow_dev@127.0.0.1:5432/coflow?sslmode=disable
