# Copy to repository root as .env.production. Do not commit real values.
COFLOW_DOMAIN=coflow.example.com
# Generate a long hexadecimal password, e.g. openssl rand -hex 32.
# Hex avoids reserved URL characters in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_generated_hex_password
# Required for first administrator creation. Generate separately: openssl rand -hex 32.
# Keep empty until configured; initialization is blocked without a valid token.
COFLOW_BOOTSTRAP_TOKEN=

# Optional AI assistant encryption key. Generate separately: openssl rand -base64 32.
# Keep stable and back it up privately; changing it makes existing API keys unreadable.
COFLOW_AI_ENCRYPTION_KEY=
