{
  "name": "coflow",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace @coflow/web",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "build": "npm run build --workspace @coflow/web",
    "typecheck": "npm run typecheck --workspace @coflow/web",
    "test:agent": "node --test scripts/agent-prompt.test.mjs",
    "test:demo": "node --test scripts/public-demo.test.mjs",
    "test:api": "cd apps/api && go test ./...",
    "version:check": "node scripts/check-version.mjs",
    "dev:demo": "cd apps/api && COFLOW_DEMO=true go run ./cmd/server",
    "test:i18n": "node --test scripts/i18n.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:images": "node --test scripts/image-release.test.mjs"
  },
  "workspaces": [
    "apps/web",
    "apps/cli"
  ],
  "version": "0.1.4",
  "license": "MIT"
}
